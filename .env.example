# ============================================================
# PREDICTIVE LAUNCH ENGINE - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ----- SOLANA RPC -----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# Recommended: use a private RPC for higher rate limits
# SOLANA_RPC_URL=https://your-private-rpc.com
# SOLANA_WS_URL=wss://your-private-rpc.com

# ----- HELIUS API (on-chain enriched data) -----
HELIUS_API_KEY=your_helius_api_key_here
# Get at: https://dev.helius.xyz

# ----- BIRDEYE API (token analytics) -----
BIRDEYE_API_KEY=your_birdeye_api_key_here
# Get at: https://docs.birdeye.so

# ----- TWITTER / X API -----
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here
# Get at: https://developer.twitter.com

# ----- TELEGRAM -----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALERT_CHAT_ID=your_chat_id_here
# Create bot via @BotFather on Telegram

# ----- DATABASE -----
DB_PATH=./data/launch_engine.db

# ----- SERVER -----
PORT=3000
DASHBOARD_SECRET=change_this_to_a_strong_secret

# ----- SCORING THRESHOLDS -----
ALERT_SCORE_THRESHOLD=0.70
HIGH_PRIORITY_THRESHOLD=0.85
SCAN_INTERVAL_MS=5000

# ----- TRADING BOT INTEGRATION (optional) -----
TRADING_BOT_WEBHOOK_URL=
TRADING_BOT_SECRET=

# ----- AUTO TRADER (compra/venda automática) -----
# ATENÇÃO: use uma carteira SEPARADA só para trading, com valor limitado
AUTO_TRADER_ENABLED=false               # mude para true para ativar
WALLET_PRIVATE_KEY=sua_chave_privada_base58_aqui

# Estratégia
AUTO_TRADE_MIN_SCORE=0.80              # score mínimo para entrar (0-1)
AUTO_TRADE_MAX_RISK=0.65               # risco máximo permitido (0-1)
AUTO_TRADE_SOL_AMOUNT=0.1              # SOL por trade (ex: 0.1)
AUTO_TRADE_TAKE_PROFIT=2.0             # vende quando atingir 2x (100% de lucro)
AUTO_TRADE_STOP_LOSS_PCT=30            # vende se cair 30%
AUTO_TRADE_MAX_POSITIONS=3             # máximo de posições simultâneas

# Execução
AUTO_TRADE_SLIPPAGE_BPS=500            # slippage 5% (500 bps)
AUTO_TRADE_PRIORITY_FEE=100000         # priority fee em lamports (~0.0001 SOL)
AUTO_TRADE_PRICE_INTERVAL_MS=10000     # checar preço a cada 10 segundos
AUTO_TRADE_MAX_HOLD_MS=1800000         # forçar venda após 30 minutos

# ----- PUMP.FUN / RAYDIUM PROGRAM IDS -----
PUMP_FUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
RAYDIUM_LIQUIDITY_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
RAYDIUM_AMM_PROGRAM_ID=5quBtoiQqxF9Jv6KYKctB59NT3gtJD2Y65kdnB1Uev3h
TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
